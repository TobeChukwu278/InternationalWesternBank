NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key for email notifications (get one at https://resend.com)
# IMPORTANT: The default sender "onboarding@resend.dev" ONLY delivers to the
# email address that owns the Resend account. For production delivery to any
# recipient, add and verify a custom domain in Resend dashboard, then update
# the FROM address in src/lib/email.ts.
RESEND_API_KEY=

# Admin panel shared password (for password-protected admin access at /admin)
ADMIN_PASSWORD=

# Production site URL (used in email links; omit trailing slash)
# Example: NEXT_PUBLIC_SITE_URL=https://international-western-bank-q75w.vercel.app
NEXT_PUBLIC_SITE_URL=
