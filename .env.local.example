NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SendGrid API key for email notifications (get one at https://sendgrid.com)
# Free tier: 100 emails/day, no custom domain needed
SENDGRID_API_KEY=

# Verified sender email (must be verified in SendGrid as a Single Sender)
# Example: SENDGRID_FROM="IWB Notifications <you@example.com>"
# Default: "IWB Notifications <noreply@iwb-bank.com>"
SENDGRID_FROM=

# Admin panel shared password (for password-protected admin access at /admin)
ADMIN_PASSWORD=

# Production site URL (used in email links; omit trailing slash)
# Example: NEXT_PUBLIC_SITE_URL=https://international-western-bank-q75w.vercel.app
NEXT_PUBLIC_SITE_URL=
