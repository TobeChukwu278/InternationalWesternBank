NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend for email notifications
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=

# The verified sender email/domain in Resend
# Example: RESEND_FROM=IWB Notifications <notifications@yourdomain.com>
RESEND_FROM=

# Admin panel shared password (for password-protected admin access at /admin)
ADMIN_PASSWORD=

# Production site URL (used in email links; omit trailing slash)
# Example: NEXT_PUBLIC_SITE_URL=https://international-western-bank-q75w.vercel.app
NEXT_PUBLIC_SITE_URL=
