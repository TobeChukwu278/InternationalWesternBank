NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail SMTP for email notifications (free, 500 emails/day)
# 1. Enable 2FA on your Google account
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Use your Gmail address as SMTP_USER and the 16-char app password as SMTP_PASS
SMTP_USER=
SMTP_PASS=

# Optional: override the From address (defaults to SMTP_USER)
SMTP_FROM=

# Admin panel shared password (for password-protected admin access at /admin)
ADMIN_PASSWORD=

# Production site URL (used in email links; omit trailing slash)
# Example: NEXT_PUBLIC_SITE_URL=https://international-western-bank-q75w.vercel.app
NEXT_PUBLIC_SITE_URL=
